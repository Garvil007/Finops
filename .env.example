# Deployment environment: dev | prod
ENV=dev
LOG_LEVEL=INFO

# FinOpsAI database (owns the "finops" schema, managed by Alembic)
DATABASE_URL=postgresql+asyncpg://finops:changeme@localhost:5432/finops

# LiteLLM proxy database (read-only source of SpendLogs, managed by LiteLLM)
LITELLM_DB_URL=postgresql+asyncpg://litellm:changeme@localhost:5432/litellm

REDIS_URL=redis://localhost:6379/0

# Budget alert destination. Leave empty to disable Slack notifications.
SLACK_WEBHOOK_URL=
