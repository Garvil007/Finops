# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Postgres (one server, two databases: "litellm" and "finopsai")
# ---------------------------------------------------------------------------
POSTGRES_USER=finops
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# FinOpsAI application
#
# From the host use localhost; from inside a compose service use "postgres".
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://finops:changeme@localhost:5432/finopsai
LITELLM_DB_URL=postgresql+asyncpg://finops:changeme@localhost:5432/litellm
REDIS_URL=redis://localhost:6379/0

# Prometheus scrape port exposed by the collectors service.
METRICS_PORT=9100

# Demo only: generate simulated compute and vector DB spend, and how much
# history to invent on a cold start. Set to false for a real deployment.
ENABLE_MOCK_COLLECTORS=true
DEMO_BACKFILL_DAYS=14

# ---------------------------------------------------------------------------
# LiteLLM proxy
#
# LITELLM_DATABASE_URL is consumed by the proxy container (Prisma, sync driver)
# and must stay a plain postgresql:// URL with the in-network "postgres" host.
# The master key must start with "sk-".
# ---------------------------------------------------------------------------
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_PORT=4000
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev-change-me
LITELLM_DATABASE_URL=postgresql://finops:changeme@postgres:5432/litellm

# Optional: leave empty to run offline against the "mock-gpt" model only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Alerting. Leave empty to disable Slack notifications.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
