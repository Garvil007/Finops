# Normalize line endings in the repo; check out LF everywhere.
* text=auto eol=lf

# Container entrypoints and mounted configs must be LF or they break in Alpine.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.md    text eol=lf

# Windows-only helpers keep CRLF.
*.bat   text eol=crlf
*.ps1   text eol=crlf
